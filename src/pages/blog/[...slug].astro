---
// src/pages/blog/[...slug].astro
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
    const posts = await getCollection('blog');

    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 公開環境変数をクライアントに渡す
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<BlogPost
    {...post.data}
    id={post.id}
    body={post.body}
    headings={headings}
    relatedPosts={[]}
>
    <Content />
</BlogPost>

<script>
    import { createClient } from '@supabase/supabase-js';

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const currentSlug = window.location.pathname.replace(/^\/blog\/|\/$/g, '');

    if (supabaseUrl && supabaseAnonKey) {
        const supabase = createClient(supabaseUrl, supabaseAnonKey);

        async function loadAiRecommendations() {
            try {
                const container = document.getElementById('ai-recommendations');
                const section = document.getElementById('ai-rec-section');
                if (!container) return;

                console.log(`[推奨] 記事のレコメンドを読み込み中: "${currentSlug}"`);

                // ===== 方案 B：recommendationsフィールドを直接クエリ =====
                const { data: postData, error: queryError } = await supabase
                    .from('post_embeddings')
                    .select('recommendations')
                    .eq('slug', currentSlug)
                    .maybeSingle();

                if (queryError) throw queryError;

                // 推奨がない場合は推奨セクションを非表示
                if (!postData?.recommendations || postData.recommendations.length === 0) {
                    console.log(`[推奨] 記事 "${currentSlug}" に推奨がありません`);
                    if (section) section.classList.add('hidden');
                    return;
                }

                console.log(`[推奨] ${postData.recommendations.length} 件の推奨が見つかりました。詳細情報を取得中...`);

                // 推奨記事の詳細情報を取得
                const { data: recommendedPosts, error: recError } = await supabase
                    .from('post_embeddings')
                    .select('slug, title, description')
                    .in('slug', postData.recommendations);

                if (recError) throw recError;

                if (!recommendedPosts || recommendedPosts.length === 0) {
                    console.log(`[推奨] 推奨記事の詳細情報の取得に失敗しました`);
                    if (section) section.classList.add('hidden');
                    return;
                }

                // 推奨カードをレンダリング
                if (section) {
                    container.innerHTML = '';
                    section.classList.remove('hidden'); // セクションを表示

                    recommendedPosts.forEach((post) => {
                        const cardHtml = `
                            <a href="/blog/${post.slug}" class="group block p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-100 dark:border-zinc-800/60 hover:border-purple-500/30 hover:bg-purple-500/[0.02] dark:hover:bg-purple-500/[0.01] transition-all duration-300">
                                <h4 class="font-bold text-gray-900 dark:text-zinc-100 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors text-base truncate">
                                    ${post.title}
                                </h4>
                                <p class="text-xs text-gray-500 dark:text-zinc-400/80 line-clamp-2 mt-1.5 leading-relaxed">
                                    ${post.description || '記事の説明がありません...'}
                                </p>
                            </a>
                        `;
                        container.insertAdjacentHTML('beforeend', cardHtml);
                    });

                    console.log(`[推奨] ${recommendedPosts.length} 件の記事をレンダリングしました`);
                }
            } catch (e) {
                console.error("[推奨] レコメンドエンジンでエラーが発生しました:", e);
                const section = document.getElementById('ai-rec-section');
                if (section) section.classList.add('hidden');
            }
        }

        // ページロード時にレコメンド読み込みを実行
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', loadAiRecommendations);
        } else {
            loadAiRecommendations();
        }
    } else {
        console.warn("[推奨] Supabase 環境変数が設定されていません");
    }
</script>