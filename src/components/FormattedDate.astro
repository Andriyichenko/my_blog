---
interface Props {
	date: Date;
}

const { date } = Astro.props;
const validDate = date instanceof Date && !isNaN(date.valueOf()) ? date : new Date();
---

<time datetime={validDate.toISOString()}>
	{
		validDate.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>