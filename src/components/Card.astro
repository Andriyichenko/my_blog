---
// src/components/Card.astro
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import defaultAvatar from '../assets/port_img.jpg'; 

interface Props extends HTMLAttributes<'a'> {
    title: string;
    mathTitle?: string;
    subtitle?: string;
    description: string;
    href: string;
    tags?: string[];
    colSpan?: '1' | '2' | '3'; 
    variant?: 'vertical' | 'horizontal';
    author?: string;
    authorImage?: ImageMetadata;
    class?: string;
    likeCount?: number;
    shareCount?: number;
}

const { 
    title, 
    mathTitle,
    subtitle,
    description, 
    href, 
    tags = [], 
    colSpan = '1', 
    variant = 'vertical', 
    author = "Alex",
    authorImage = defaultAvatar,
    class: className, 
    likeCount = 0,
    shareCount = 0,
    ...props 
} = Astro.props;

const spanClasses = {
    '1': 'md:col-span-1',
    '2': 'md:col-span-2',
    '3': 'md:col-span-3',
};

const baseClasses = "group relative overflow-hidden transition-all duration-300 bg-surface-variant/20 border border-outline/10 hover:bg-surface-variant/40 hover:scale-[1.01] hover:shadow-lg hover:border-primary/20 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2";
const verticalClasses = `flex flex-col justify-between p-6 sm:p-8 rounded-3xl ${spanClasses[colSpan]}`;
const horizontalClasses = "flex flex-row items-center p-4 rounded-xl h-32 md:h-36 gap-4";

const activeClasses = variant === 'horizontal' ? horizontalClasses : verticalClasses;

const authorSlug = author.toLowerCase().replace(/ /g, '-');
---

<a href={href} aria-label={title} class:list={[baseClasses, activeClasses, className]} {...props}>
    <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors duration-500 pointer-events-none" aria-hidden="true"></div>
    
    {variant === 'horizontal' ? (
        <>
            <div class="flex-grow min-w-0 flex flex-col h-full py-1 gap-2">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <h3 class="text-lg font-bold text-on-surface truncate group-hover:text-primary transition-colors pr-2 card-title">
                            {mathTitle ? (
                                <span
                                    class="inline-block katex-latex"
                                    data-latex={mathTitle}
                                ></span>
                            ) : (
                                title
                            )}
                        </h3>
                        {subtitle && (
                            <p class="text-xs font-serif italic text-on-surface-variant/70 -mt-1 mb-1">
                                {subtitle}
                            </p>
                        )}
                        <p class="text-sm text-on-surface-variant/80 line-clamp-2 mt-1">
                            {description}
                        </p>
                    </div>

                    <div class="shrink-0" aria-hidden="true">
                        <div class="w-8 h-8 rounded-full bg-surface/50 flex items-center justify-center text-on-surface-variant group-hover:bg-primary group-hover:text-on-primary transition-all duration-300">
                            <svg class="w-4 h-4 transform group-hover:-rotate-45 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </div>
                    </div>
                </div>
                
                <div class="flex items-center justify-between mt-auto pt-1">
                    {tags.length > 0 && (
                        <div class="flex flex-wrap gap-1.5">
                            {tags.slice(0, 2).map((tag) => (
                                <span class="px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider rounded-md bg-surface text-on-surface-variant border border-outline/10">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    )}
                    
                    <div class="flex items-center gap-2 pl-2 border-l border-outline/10 ml-auto">
                        <div class="w-5 h-5 rounded-full overflow-hidden ring-1 ring-white dark:ring-zinc-700">
                            <img
                                src={`/authors/${authorSlug}.jpg`}
                                alt={author}
                                width={20}
                                height={20}
                                class="w-full h-full object-cover"
                                onerror="this.onerror=null;this.src='/authors/default.jpg'"
                            />
                        </div>
                        <span class="text-xs font-medium text-on-surface-variant truncate max-w-[80px]">
                            {author}
                        </span>
                    </div>
                </div>
            </div>
        </>
    ) : (
        <>
            {/* Vertical Layout */}
            <div class="z-10 flex flex-col h-full">
                <div class="mb-auto">
                    <h3 class="text-xl sm:text-2xl font-bold text-on-surface mb-3 group-hover:text-primary transition-colors card-title">
                        {mathTitle ? (
                            <span 
                                class="inline-block katex-latex"
                                data-latex={mathTitle}
                            ></span>
                        ) : (
                            title
                        )}
                    </h3>
                    {subtitle && (
                        <p class="text-base sm:text-lg font-serif italic text-on-surface-variant/70 -mt-2 mb-4">
                            {subtitle}
                        </p>
                    )}
                    <p class="text-on-surface-variant text-base sm:text-lg leading-relaxed mb-6">
                        {description}
                    </p>
                </div>

                <div class="flex items-end justify-between mt-6 border-t border-outline/10 pt-4">
                    {tags.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                            {tags.map((tag) => (
                                <span class="px-3 py-1 text-xs font-medium uppercase tracking-wider rounded-full bg-surface text-on-surface-variant border border-outline/10 group-hover:border-primary/30 group-hover:text-primary transition-colors">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    )}
                    
                    <div class="flex items-center gap-2 pl-3 border-l border-outline/10">
                        <div class="w-6 h-6 rounded-full overflow-hidden ring-1 ring-white dark:ring-zinc-700">
                            <img
                                src={`/authors/${authorSlug}.jpg`}
                                alt={author}
                                width={24}
                                height={24}
                                class="w-full h-full object-cover"
                                onerror="this.onerror=null;this.src='/authors/default.jpg'"
                            />
                        </div>
                        <span class="text-sm font-medium text-on-surface-variant">{author}</span>
                    </div>
                </div>
            </div>
        </>
    )}
</a>

<script is:inline>
  function renderLatexNodes() {
    console.log('[Card] 开始渲染 LaTeX 节点...');
    
    const nodes = document.querySelectorAll('.katex-latex');
    console.log('[Card] 找到 .katex-latex 节点数:', nodes.length);

    if (!window.MathJax || !window.MathJax.typesetPromise) {
      console.warn('[Card] MathJax 未加载，无法渲染');
      return;
    }

    // 用 MathJax 处理所有节点
    window.MathJax.typesetPromise(Array.from(nodes)).then(() => {
      console.log('[Card] ✅ MathJax 渲染完成');
      nodes.forEach((el) => {
        el.setAttribute('data-rendered', '1');
      });
    }).catch(err => {
      console.error('[Card] ❌ MathJax 渲染失败:', err);
    });
  }

  // 等待 MathJax 加载
  (function waitMathJax() {
    console.log('[Card] 脚本启动，检查 MathJax...');
    
    if (window.MathJax?.typesetPromise) {
      console.log('[Card] MathJax 已存在，立即渲染');
      renderLatexNodes();
      return;
    }

    let attempts = 0;
    const maxAttempts = 100; // 最多等待 10 秒
    
    const t = setInterval(() => {
      attempts++;
      if (window.MathJax?.typesetPromise) {
        console.log(`[Card] MathJax 已加载（第 ${attempts} 次检查），开始渲染`);
        clearInterval(t);
        renderLatexNodes();
      } else if (attempts >= maxAttempts) {
        console.error('[Card] 超时：MathJax 未在预期时间内加载');
        clearInterval(t);
      }
    }, 100);
  })();

  // 监听页面加载完成事件
  document.addEventListener('DOMContentLoaded', () => {
    console.log('[Card] DOMContentLoaded 触发');
    setTimeout(renderLatexNodes, 200);
  });

  window.addEventListener('load', () => {
    console.log('[Card] window load 触发');
    setTimeout(renderLatexNodes, 200);
  });

  // 监听动态内容（如推荐卡片）的插入
  const observer = new MutationObserver(() => {
    const unrenderedNodes = document.querySelectorAll('.katex-latex[data-rendered!="1"]');
    if (unrenderedNodes.length > 0) {
      console.log('[Card] 检测到新的 LaTeX 节点，重新渲染');
      setTimeout(renderLatexNodes, 100);
    }
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true,
    attributes: false
  });
</script>