---
// src/layouts/BlogPost.astro
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import FloatingTOC from '../components/FloatingTOC.jsx';
import { people } from '../data/people';

const frontmatter = Astro.props.frontmatter || Astro.props;

const {
    id,
    title,
    subtitle,
    mathTitle,
    description,
    pubDate,
    updatedDate,
    heroImage,
    author = "Andre YI",
    authorImage,
    subcategory,
    tags = [],
    relatedPosts = [],
    body = ""
} = frontmatter;

// 查找作者信息
let authorSlug = 'Andre';
let authorAvatar = `/authors/default.jpg`;

if (author && people && people.length > 0) {
    let found = people.find((p: any) => p.nameEn === author);
    
    if (!found) {
        found = people.find((p: any) => p.nameEn.includes(author));
    }
    
    if (!found) {
        const authorParts = author.split(/\s+/);
        found = people.find((p: any) => 
            authorParts.some(part => p.nameEn.includes(part))
        );
    }
    
    if (!found) {
        found = people.find((p: any) => p.name === author);
    }
    
    if (!found) {
        found = people.find((p: any) => p.name.includes(author));
    }
    
    if (!found) {
        const authorParts = author.split(/\s+/);
        found = people.find((p: any) => 
            authorParts.some(part => p.name.includes(part))
        );
    }
    
    if (found) {
        authorSlug = found.slug || 'Andre';
        authorAvatar = found.avatar || `/authors/default.jpg`;
    } else {
        console.warn('⚠️ 未找到作者:', author);
    }
}

const headings = Astro.props.headings || frontmatter.headings || [];

const wordCount = body ? body.split(/\s+/g).length : 0;
const readingTime = Math.ceil(wordCount / 200) || 5;
const safePubDate = pubDate ? new Date(pubDate) : new Date();

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title={title} description={description}>
    <!-- MathJax CDN 脚本 - 放在最前面 -->
    <script is:inline id="mathjax-config">
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']],
                processEscapes: true
            },
            chtml: {
                matchFontHeight: false,
                scale: 1.0
            }
        };
    </script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>

    <div class="sticky top-0 z-40 bg-white/95 dark:bg-black/90 backdrop-blur-xl border-b border-zinc-200/60 dark:border-zinc-800/60">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-start py-2">
                <a href="javascript:void(0)" id="back-btn" aria-label="返回" class="flex items-center justify-center w-10 h-10 rounded-full text-zinc-500 dark:text-zinc-400 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-purple-50 dark:hover:bg-purple-900/20 transition-all border border-transparent hover:border-purple-200/60 dark:hover:border-purple-700/60 shadow-sm">
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12 relative">
        <div class="max-w-3xl mx-auto text-center mb-12">
            {subcategory && (
                <div class="flex justify-center mb-6">
                    <span class="px-3 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 text-xs font-bold uppercase tracking-wider rounded-full">
                        {subcategory}
                    </span>
                </div>
            )}

            <!-- 关键：添加 id="post-title" 以便稍后 MathJax 处理 -->
            <h1 id="post-title" class="text-4xl md:text-5xl font-serif font-bold text-zinc-900 dark:text-white mb-4 leading-tight">
                {mathTitle ? <span set:html={mathTitle} /> : title}
            </h1>

            {subtitle && (
                <p class="text-xl md:text-2xl font-serif italic text-zinc-500 dark:text-zinc-400 -mt-2 mb-6">
                    {subtitle}
                </p>
            )}

            <div class="flex flex-col md:flex-row items-center justify-center gap-4 text-zinc-500 dark:text-zinc-400 text-sm py-2">
                <a href={`/about/people/${authorSlug}`} class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                    <div class="w-8 h-8 rounded-full overflow-hidden ring-2 ring-white dark:ring-zinc-800 shadow-sm">
                        <img
                            src={authorAvatar}
                            alt={author}
                            width={32}
                            height={32}
                            class="w-full h-full object-cover object-center"
                            onerror="this.onerror=null;this.src='/authors/default.jpg'"
                        />
                    </div>
                    <span class="font-medium text-zinc-900 dark:text-zinc-200 hover:text-purple-600 transition-colors">{author}</span>
                </a>

                <span class="hidden md:inline">•</span>

                <div class="flex items-center gap-4">
                    <FormattedDate date={safePubDate} />
                    <span>{readingTime} min read</span>
                </div>
            </div>

            <div class="mt-4 flex items-center justify-center gap-3">
                <button
                    id="like-btn-hero"
                    aria-label="Like"
                    type="button"
                    class="flex items-center gap-2 px-4 py-2 rounded-full border border-rose-200/70 dark:border-rose-800/60 text-rose-500 dark:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-all shadow-sm hover:shadow active:scale-95"
                >
                    <span id="like-icon-hero" class="text-base">♡</span>
                    <span id="like-count-hero" class="text-sm font-semibold">0</span>
                </button>

                <button
                    id="share-btn-hero"
                    aria-label="Share"
                    type="button"
                    class="flex items-center gap-2 px-4 py-2 rounded-full border border-blue-200/70 dark:border-blue-800/60 text-blue-500 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all shadow-sm hover:shadow active:scale-95"
                >
                    <span class="text-base">↗</span>
                    <span class="text-sm font-semibold">Share</span>
                </button>
            </div>

            <div id="share-toast-hero" class="mt-3 text-sm text-green-500 opacity-0 transition-opacity duration-300">
                链接已复制！
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 max-w-7xl mx-auto">
            <div class="lg:col-span-8 lg:col-start-3">
                <div id="post-content-area" class="prose prose-lg prose-zinc dark:prose-invert max-w-none prose-math">
                    <slot />
                </div>

                <div class="mt-16 py-6 border-t border-zinc-200 dark:border-zinc-800">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <button
                                id="like-btn-bottom"
                                aria-label="Like"
                                type="button"
                                class="group flex items-center gap-2 pl-3 pr-3 py-2 rounded-full border border-rose-200/70 dark:border-rose-800/60 text-rose-500 dark:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-all shadow-sm hover:shadow active:scale-95"
                            >
                                <span id="like-icon-bottom" class="text-base">♡</span>
                                <span id="like-count-bottom" class="text-sm font-semibold">0</span>
                            </button>

                            <button
                                id="share-btn-bottom"
                                aria-label="Share"
                                type="button"
                                class="group flex items-center gap-2 pl-3 pr-3 py-2 rounded-full border border-blue-200/70 dark:border-blue-800/60 text-blue-500 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all shadow-sm hover:shadow"
                            >
                                <span class="text-base">↗</span>
                                <span class="text-sm font-semibold">Share</span>
                            </button>

                            <span id="share-toast-bottom" class="text-sm text-green-500 opacity-0 transition-opacity duration-300">
                                链接已复制！
                            </span>
                        </div>

                        <a href="/blog" class="flex items-center gap-1.5 text-sm text-zinc-500 dark:text-zinc-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors">
                            <span>更多笔记</span>
                            <span class="font-serif">→</span>
                        </a>
                    </div>
                </div>

                {tags.length > 0 && (
                    <div class="mt-8">
                        <div class="flex flex-wrap gap-2">
                            {tags.map((tag: string) => (
                                <span class="px-3 py-1 bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 text-xs font-medium rounded-full hover:bg-purple-100 dark:hover:bg-purple-900/30 hover:text-purple-700 transition-colors cursor-default">
                                    #{tag}
                                </span>
                            ))}
                        </div>
                    </div>
                )}
            </div>

            <div class="hidden xl:block col-span-2"></div>
        </div>

        <FloatingTOC headings={headings} client:load />

        {relatedPosts.length > 0 && (
            <div class="max-w-3xl mx-auto mt-24 pt-12 border-t border-zinc-200 dark:border-zinc-800 pb-24">
                <div class="flex items-center justify-between mb-8">
                    <h3 class="text-2xl font-serif font-bold text-zinc-900 dark:text-white">Up Next</h3>
                    <a href="/blog" class="text-sm font-medium text-purple-600 hover:text-purple-500">View all</a>
                </div>

                <div class="space-y-4">
                    {relatedPosts.map((post: any) => (
                        <a href={`/blog/${post.id}/`} class="group flex items-center gap-4 p-3 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors border border-transparent hover:border-zinc-200 dark:hover:border-zinc-700">
                            <div class="shrink-0 w-16 h-16 rounded-lg overflow-hidden bg-zinc-200 dark:bg-zinc-800 relative">
                                {post.data.heroImage ? (
                                    <img src={post.data.heroImage.src} alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center text-xl font-serif italic text-zinc-400">
                                        {post.data.title.charAt(0)}
                                    </div>
                                )}
                            </div>

                            <div class="flex-grow min-w-0">
                                <h4 class="font-bold text-base text-zinc-900 dark:text-white truncate group-hover:text-purple-600 transition-colors">
                                    {post.data.title}
                                </h4>
                                <p class="text-xs text-zinc-500 line-clamp-1">{post.data.description}</p>
                            </div>

                            <div class="shrink-0 text-zinc-300 group-hover:text-purple-600 transition-colors transform group-hover:translate-x-1">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                </svg>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        )}

        <div id="ai-rec-section" class="max-w-3xl mx-auto mt-16 pt-12 border-t border-zinc-200 dark:border-zinc-800 pb-24">
            <div class="flex items-center justify-between mb-8">
                <h3 class="text-2xl font-serif font-bold text-zinc-900 dark:text-white">お気に入りそうな記事</h3>
                <a href="/blog" class="text-sm font-medium text-purple-600 hover:text-purple-500">View all</a>
            </div>

            <div id="ai-recommendations" class="space-y-4"></div>
        </div>
    </article>
</Layout>

<script define:vars={{ id, supabaseUrl, supabaseAnonKey }}>
    document.addEventListener('DOMContentLoaded', async () => {
        // 🔥 关键：在标题渲染后立即调用 MathJax 处理标题
        if (window.MathJax && window.MathJax.typesetPromise) {
            try {
                console.log('🔄 处理标题中的 LaTeX...');
                await MathJax.typesetPromise([document.getElementById('post-title')]);
                console.log('✅ 标题 LaTeX 渲染完成');
            } catch (error) {
                console.error('❌ 标题 LaTeX 渲染失败:', error);
            }
        }

        const slug = id || window.location.pathname.split('/blog/')[1]?.replace(/\/$/, '');
        
        console.log('📄 页面初始化 - Article slug:', slug);

        // ===== 返回按钮处理 =====
        const backBtn = document.getElementById('back-btn');
        if (backBtn) {
            backBtn.addEventListener('click', (e) => {
                e.preventDefault();
                if (window.history.length > 1) {
                    window.history.back();
                } else {
                    window.location.href = '/';
                }
            });
        }

        // ===== 获取用户标识 =====
        let userIdentifier = null;

        async function getUserIP() {
            try {
                const res = await fetch('https://api.ipify.org?format=json');
                if (res.ok) {
                    const data = await res.json();
                    return data.ip;
                }
            } catch (error) {
                console.warn('⚠️ 无法获取IP');
            }
            return null;
        }

        try {
            userIdentifier = await getUserIP();
            if (userIdentifier) {
                console.log('✅ 用户IP:', userIdentifier);
            } else {
                console.warn('⚠️ 未获取到IP，使用备用指纹');
                userIdentifier = generateDeviceFingerprint();
            }
        } catch (error) {
            console.warn('⚠️ 异常，使用备用指纹:', error);
            userIdentifier = generateDeviceFingerprint();
        }

        // ===== 行为追踪 =====
        let startTime = Date.now();
        
        window.addEventListener('pagehide', () => {
            const timeSpent = (Date.now() - startTime) / 1000;
            const wordCount = document.getElementById('post-content-area')?.innerText?.trim()?.length || 0;

            if (timeSpent > 5 && supabaseUrl && supabaseAnonKey) {
                const payload = JSON.stringify({ 
                    word_count: wordCount, 
                    time_spent: timeSpent, 
                    url: window.location.pathname 
                });

                fetch(`${supabaseUrl}/rest/v1/blog_analytics`, {
                    method: 'POST',
                    headers: {
                        'apikey': supabaseAnonKey,
                        'Authorization': `Bearer ${supabaseAnonKey}`,
                        'Content-Type': 'application/json',
                        'Prefer': 'return=minimal'
                    },
                    body: payload,
                    keepalive: true
                });
            }
        });

        // ===== 点赞系统 =====
        const likeButtons = [
            document.getElementById('like-btn-hero'),
            document.getElementById('like-btn-bottom'),
        ];

        const likeIcons = [
            document.getElementById('like-icon-hero'),
            document.getElementById('like-icon-bottom'),
        ];

        const likeCounts = [
            document.getElementById('like-count-hero'),
            document.getElementById('like-count-bottom'),
        ];

        const shareButtons = [
            document.getElementById('share-btn-hero'),
            document.getElementById('share-btn-bottom'),
        ];

        const shareToasts = [
            document.getElementById('share-toast-hero'),
            document.getElementById('share-toast-bottom'),
        ];

        let isLiked = false;
        let likeCount = 0;
        let isLikePending = false;

        const likedClasses = [
            'bg-rose-50',
            'dark:bg-rose-900/30',
            'shadow-lg',
            'shadow-rose-500/15',
            'border-rose-300/80',
            'dark:border-rose-600/70',
            'scale-[1.01]',
        ];

        function updateLikeUI() {
            likeCounts.filter(Boolean).forEach((el) => {
                el.textContent = likeCount.toString();
            });

            likeIcons.filter(Boolean).forEach((el) => {
                el.textContent = isLiked ? '♥' : '♡';
            });

            likeButtons.filter(Boolean).forEach((btn) => {
                if (isLiked) {
                    btn.classList.add(...likedClasses);
                    btn.setAttribute('aria-pressed', 'true');
                    btn.disabled = false;
                } else {
                    btn.classList.remove(...likedClasses);
                    btn.setAttribute('aria-pressed', 'false');
                    btn.disabled = false;
                }
            });
        }

        // 获取当前点赞总数
        async function fetchLikeCount() {
            if (!slug || !supabaseUrl || !supabaseAnonKey) {
                console.warn('❌ 缺少必要参数：slug或Supabase凭证');
                return 0;
            }

            try {
                const res = await fetch(
                    `${supabaseUrl}/rest/v1/post_stats?slug=eq.${encodeURIComponent(slug)}&select=like_count`,
                    {
                        headers: {
                            'apikey': supabaseAnonKey,
                            'Authorization': `Bearer ${supabaseAnonKey}`,
                        },
                    }
                );

                if (!res.ok) {
                    console.error('❌ 获取点赞数失败:', res.status);
                    return 0;
                }

                const data = await res.json();
                const count = data?.[0]?.like_count ?? 0;
                console.log('✅ 获取点赞数成功:', count);
                return count;
            } catch (error) {
                console.error('❌ fetchLikeCount error:', error);
                return 0;
            }
        }

        // 检查当前用户是否已赞
        async function checkUserLikeStatus() {
            if (!slug || !userIdentifier || !supabaseUrl || !supabaseAnonKey) {
                console.warn('❌ 缺少必要参数，跳过已赞检查');
                return false;
            }

            try {
                const res = await fetch(
                    `${supabaseUrl}/rest/v1/post_likes?slug=eq.${encodeURIComponent(slug)}&user_ip=eq.${encodeURIComponent(userIdentifier)}&select=id`,
                    {
                        headers: {
                            'apikey': supabaseAnonKey,
                            'Authorization': `Bearer ${supabaseAnonKey}`,
                        },
                    }
                );

                if (!res.ok) {
                    console.error('❌ 检查已赞状态失败:', res.status);
                    return false;
                }

                const data = await res.json();
                const liked = data.length > 0;
                console.log('✅ 用户已赞状态:', liked);
                return liked;
            } catch (error) {
                console.error('❌ checkUserLikeStatus error:', error);
                return false;
            }
        }

        // 初始化点赞状态
        async function initLike() {
            console.log('🔄 初始化点赞状态...');
            likeCount = await fetchLikeCount();
            isLiked = await checkUserLikeStatus();
            updateLikeUI();
            console.log(`✅ 初始化完成 - 总赞数: ${likeCount}, 当前用户已赞: ${isLiked}`);
        }

        // 处理点赞 - 支持切换
        async function handleLike() {
            if (!slug || isLikePending || !supabaseUrl || !supabaseAnonKey || !userIdentifier) {
                console.warn('❌ 缺少必要参数，无法点赞');
                return;
            }

            if (isLiked) {
                await handleUnlike();
            } else {
                await addLike();
            }
        }

        // 点赞
        async function addLike() {
            isLikePending = true;
            console.log('🔄 正在提交点赞...');

            try {
                const res = await fetch(
                    `${supabaseUrl}/rest/v1/rpc/increment_like`,
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'apikey': supabaseAnonKey,
                            'Authorization': `Bearer ${supabaseAnonKey}`,
                        },
                        body: JSON.stringify({
                            p_slug: slug,
                            p_user_ip: userIdentifier,
                        }),
                    }
                );

                console.log('📡 RPC 响应状态:', res.status);

                if (!res.ok) {
                    const errorText = await res.text();
                    console.error('❌ RPC 调用失败:', res.status, errorText);
                    alert('点赞失败，请稍后重试');
                    isLikePending = false;
                    return;
                }

                const result = await res.json();
                console.log('✅ RPC 返回结果:', result);

                if (result.success) {
                    console.log('✅ 点赞成功！');
                    isLiked = true;
                    likeCount = result.like_count || likeCount + 1;
                    updateLikeUI();
                } else {
                    console.warn('⚠️ 点赞失败:', result.error);
                    if (result.code === 'ALREADY_LIKED') {
                        isLiked = true;
                        updateLikeUI();
                        console.log('ℹ️ 您已经赞过这篇文章了');
                    } else {
                        alert(result.error || '点赞失败');
                    }
                }
            } catch (error) {
                console.error('❌ 点赞请求异常:', error);
                alert('点赞失败，请检查网络连接');
            } finally {
                isLikePending = false;
            }
        }

        // 取消点赞
        async function handleUnlike() {
            isLikePending = true;
            console.log('🔄 正在取消点赞...');

            try {
                const res = await fetch(
                    `${supabaseUrl}/rest/v1/post_likes?slug=eq.${encodeURIComponent(slug)}&user_ip=eq.${encodeURIComponent(userIdentifier)}`,
                    {
                        method: 'DELETE',
                        headers: {
                            'apikey': supabaseAnonKey,
                            'Authorization': `Bearer ${supabaseAnonKey}`,
                        },
                    }
                );

                console.log('📡 DELETE 响应状态:', res.status);

                if (!res.ok) {
                    const errorText = await res.text();
                    console.error('❌ 取消点赞失败:', res.status, errorText);
                    alert('取消点赞失败，请稍后重试');
                    isLikePending = false;
                    return;
                }

                console.log('✅ 取消点赞成功！');
                isLiked = false;
                likeCount = Math.max(0, likeCount - 1);
                updateLikeUI();

                try {
                    await fetch(
                        `${supabaseUrl}/rest/v1/rpc/decrement_like`,
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'apikey': supabaseAnonKey,
                                'Authorization': `Bearer ${supabaseAnonKey}`,
                            },
                            body: JSON.stringify({
                                p_slug: slug,
                            }),
                        }
                    );
                } catch (err) {
                    console.warn('⚠️ 更新点赞计数失败:', err);
                }
            } catch (error) {
                console.error('❌ 取消点赞请求异常:', error);
                alert('取消点赞失败，请检查网络连接');
            } finally {
                isLikePending = false;
            }
        }

        // 分享功能
        function showShareToast() {
            shareToasts.forEach((toast) => {
                if (!toast) return;
                toast.style.opacity = '1';
                setTimeout(() => {
                    toast.style.opacity = '0';
                }, 2000);
            });
        }

        async function handleShare() {
            const url = window.location.href;

            try {
                if (navigator.share) {
                    await navigator.share({
                        title: document.title,
                        url,
                    });
                } else {
                    await navigator.clipboard.writeText(url);
                    showShareToast();
                }
            } catch (_) {
                return;
            }

            if (!slug || !supabaseUrl || !supabaseAnonKey) return;

            try {
                const res = await fetch(
                    `${supabaseUrl}/rest/v1/rpc/increment_share`,
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'apikey': supabaseAnonKey,
                            'Authorization': `Bearer ${supabaseAnonKey}`,
                        },
                        body: JSON.stringify({
                            p_slug: slug,
                        }),
                    }
                );

                if (!res.ok) {
                    console.error('❌ increment_share failed:', res.status);
                    return;
                }

                const result = await res.json();
                console.log('✅ 分享计数已更新:', result);
            } catch (err) {
                console.error('❌ increment_share error:', err);
            }
        }

        // 绑定事件
        likeButtons.forEach((btn) => {
            if (btn) btn.addEventListener('click', handleLike);
        });
        shareButtons.forEach((btn) => {
            if (btn) btn.addEventListener('click', handleShare);
        });

        // 初始化点赞
        await initLike();

        // ===== 【方案 B】AI 推荐系统 =====
        async function initAIRecommendations() {
            console.log('🤖 【方案B】初始化 AI 推荐系统...');
            
            if (!slug || !supabaseUrl || !supabaseAnonKey) {
                console.warn('❌ 缺少必要参数，跳过推荐');
                return;
            }

            try {
                const { data: postData, error: postError } = await fetch(
                    `${supabaseUrl}/rest/v1/post_embeddings?slug=eq.${encodeURIComponent(slug)}&select=recommendations`,
                    {
                        headers: {
                            'apikey': supabaseAnonKey,
                            'Authorization': `Bearer ${supabaseAnonKey}`,
                        },
                    }
                ).then(r => r.json()).then(data => ({ data, error: null }))
                .catch(err => ({ data: null, error: err }));

                if (postError || !postData || postData.length === 0) {
                    console.warn('⚠️ 未找到当前文章的推荐数据');
                    return;
                }

                const recommendationSlugs = postData[0].recommendations;
                console.log('✅ 获取到推荐列表:', recommendationSlugs);

                if (!recommendationSlugs || recommendationSlugs.length === 0) {
                    console.warn('⚠️ 推荐列表为空');
                    return;
                }

                const { data: recommendedPosts, error: recError } = await fetch(
                    `${supabaseUrl}/rest/v1/post_embeddings?slug=in.(${encodeURIComponent(recommendationSlugs.join(','))})`
                        + `&select=slug,title,description,embedding`,
                    {
                        headers: {
                            'apikey': supabaseAnonKey,
                            'Authorization': `Bearer ${supabaseAnonKey}`,
                        },
                    }
                ).then(r => r.json()).then(data => ({ data, error: null }))
                .catch(err => ({ data: null, error: err }));

                if (recError || !recommendedPosts) {
                    console.error('❌ 获取推荐文章详情失败:', recError);
                    return;
                }

                console.log('✅ 获取到推荐文章数:', recommendedPosts.length);

                const currentEmbedding = postData[0].embedding ? parseEmbedding(postData[0].embedding) : null;
                
             const recommendationsWithSimilarity = recommendedPosts
                .slice(0, 3)  
                .map(post => ({
                    slug: post.slug,
                    title: post.title || '未命名',
                    description: post.description || '暂无描述',
                    similarity: currentEmbedding && post.embedding 
                        ? cosineSimilarity(currentEmbedding, parseEmbedding(post.embedding))
                        : 0.85
                }));

                console.log('✅ 推荐文章处理完毕:', recommendationsWithSimilarity.length);
                recommendationsWithSimilarity.forEach(r => {
                    console.log(`  - ${r.slug}: 相似度 ${r.similarity.toFixed(3)}`);
                });

                renderRecommendations(recommendationsWithSimilarity);

            } catch (error) {
                console.error('❌ AI 推荐初始化失败:', error);
            }
        }

        function parseEmbedding(embedding) {
            try {
                if (!embedding) return null;

                if (Array.isArray(embedding)) {
                    return embedding;
                }

                if (typeof embedding === 'string') {
                    const cleaned = embedding
                        .replace(/^\[/, '')
                        .replace(/\]$/, '')
                        .split(',')
                        .map(v => {
                            const num = parseFloat(v.trim());
                            return isNaN(num) ? 0 : num;
                        });
                    return cleaned.length > 0 ? cleaned : null;
                }

                return null;
            } catch (error) {
                console.error('❌ parseEmbedding 错误:', error);
                return null;
            }
        }

        function cosineSimilarity(vecA, vecB) {
            if (!vecA || !vecB || vecA.length !== vecB.length) {
                return 0;
            }

            let dotProduct = 0;
            let magnitudeA = 0;
            let magnitudeB = 0;

            for (let i = 0; i < vecA.length; i++) {
                dotProduct += vecA[i] * vecB[i];
                magnitudeA += vecA[i] * vecA[i];
                magnitudeB += vecB[i] * vecB[i];
            }

            magnitudeA = Math.sqrt(magnitudeA);
            magnitudeB = Math.sqrt(magnitudeB);

            if (magnitudeA === 0 || magnitudeB === 0) {
                return 0;
            }

            return dotProduct / (magnitudeA * magnitudeB);
        }

        function renderRecommendations(recommendations) {
            const container = document.getElementById('ai-recommendations');
            const section = document.getElementById('ai-rec-section');
            
            if (!container) return;

            if (recommendations.length === 0) {
                if (section) section.classList.add('hidden');
                return;
            }

            container.innerHTML = recommendations
                .map(post => `
                    <a href="/blog/${post.slug}/" class="group block">
                        <div class="p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 hover:border-purple-300 dark:hover:border-purple-700 hover:shadow-lg transition-all duration-300 bg-white dark:bg-zinc-900/50">
                            <div class="flex items-start justify-between gap-4 mb-4">
                                <h3 class="text-lg font-bold text-zinc-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors flex-grow">
                                    ${post.title}
                                </h3>
                                <span class="shrink-0 px-3 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 text-xs font-bold rounded-full whitespace-nowrap">
                                    ${(post.similarity * 100).toFixed(0)}% マッチ
                                </span>
                            </div>

                            <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2 mb-4">
                                ${post.description}
                            </p>

                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <span class="text-xs text-zinc-500">おすすめ指数</span>
                                    <div class="flex gap-1">
                                        ${Array(5).fill(0).map((_, i) => `
                                            <div class="w-1.5 h-1.5 rounded-full ${i < Math.ceil(post.similarity * 5) ? 'bg-purple-500' : 'bg-zinc-300 dark:bg-zinc-600'}"></div>
                                        `).join('')}
                                    </div>
                                </div>
                                <svg class="w-5 h-5 text-zinc-400 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-all transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                </svg>
                            </div>
                        </div>
                    </a>
                `)
                .join('');

            if (section) section.classList.remove('hidden');
            console.log('✅ 推荐卡片渲染完成');
        }

        await initAIRecommendations();
    });

    function generateDeviceFingerprint() {
        const ua = navigator.userAgent;
        const screen = `${window.screen.width}x${window.screen.height}`;
        const tz = new Date().getTimezoneOffset();
        
        const fingerprint = `${ua}|${screen}|${tz}`;
        
        let hash = 0;
        for (let i = 0; i < fingerprint.length; i++) {
            const char = fingerprint.charCodeAt(i);
            hash = ((hash << 5) - hash) + char;
            hash = hash & hash;
        }
        
        return `fp_${Math.abs(hash)}`;
    }
</script>